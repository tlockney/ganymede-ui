{
  "name": "ganymede-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A standalone notebook UI for Ganymede, built on datalayer/jupyter-ui.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "check": "tsc -p . && node scripts/check-notes.mjs",
    "test": "npm test -w packages/client"
  },
  "dependencies": {
    "@datalayer/jupyter-react": "^2.0.20",
    "@jupyterlab/coreutils": "^6.0.0",
    "@jupyterlab/services": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-treat-umd-as-commonjs": "^0.1.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT"
}
