{
  "name": "ganymede-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "A standalone notebook UI for Ganymede, built on JupyterLab's notebook packages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "check": "tsc -p . && tsc -p e2e && tsc -p packages/agent && node scripts/check-notes.mjs && npm run lint && npm run format:check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && npm test -w packages/client",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "@jupyter-widgets/base": "6.0.12",
    "@jupyter-widgets/controls": "5.0.13",
    "@jupyter-widgets/jupyterlab-manager": "5.0.16",
    "@jupyter/web-components": "0.16.7",
    "@jupyter/ydoc": "4.1.1",
    "@jupyterlab/apputils": "4.7.4",
    "@jupyterlab/cell-toolbar": "4.6.4",
    "@jupyterlab/cells": "4.6.4",
    "@jupyterlab/codeeditor": "4.6.4",
    "@jupyterlab/codemirror": "4.6.4",
    "@jupyterlab/completer": "4.6.4",
    "@jupyterlab/coreutils": "6.6.4",
    "@jupyterlab/documentsearch": "4.6.4",
    "@jupyterlab/javascript-extension": "4.6.4",
    "@jupyterlab/json-extension": "4.6.4",
    "@jupyterlab/markedparser-extension": "4.6.4",
    "@jupyterlab/mathjax-extension": "4.6.4",
    "@jupyterlab/nbformat": "4.6.4",
    "@jupyterlab/notebook": "4.6.4",
    "@jupyterlab/observables": "5.6.4",
    "@jupyterlab/rendermime": "4.6.4",
    "@jupyterlab/rendermime-interfaces": "3.14.4",
    "@jupyterlab/services": "7.6.4",
    "@jupyterlab/theme-dark-extension": "4.6.4",
    "@jupyterlab/theme-light-extension": "4.6.4",
    "@jupyterlab/tooltip": "4.6.4",
    "@jupyterlab/ui-components": "4.6.4",
    "@jupyterlite/javascript-kernel": "0.4.0-alpha.3",
    "@jupyterlite/services": "0.8.6",
    "@lumino/commands": "2.3.4",
    "@lumino/coreutils": "2.2.3",
    "@lumino/disposable": "2.1.6",
    "@lumino/messaging": "2.0.5",
    "@lumino/signaling": "2.1.6",
    "@lumino/widgets": "2.10.0",
    "@tlockney/cdp-kernel": "0.7.1",
    "@tlockney/ganymede-device": "github:tlockney/ganymede-device#claude/ganymede-ui-auth-device-d33kix",
    "localforage": "1.10.0",
    "mock-socket": "9.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "overrides": {
    "@jupyterlite/javascript-kernel": {
      "@jupyterlite/services": "$@jupyterlite/services"
    },
    "@jupyterlab/console": "4.6.4",
    "@jupyterlab/logconsole": "4.6.4",
    "@jupyterlab/mainmenu": "4.6.4"
  }
}
